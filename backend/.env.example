# Copy to backend/.env for local (non-docker) runs.
# docker-compose sets these inline; docker-compose values win.

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://vct:vct@localhost:5432/vctanalyzer
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-secret-change-me
STORAGE_DIR=./storage/vods
MODEL_VERSION=model_v0-mock

# --- External ingest (optional — features degrade when unset) ---
# Twitch Helix: enables VOD/clip metadata (title, channel, duration).
# Without it, plain twitch.tv/videos/{id} URLs still resolve for embed playback.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# YouTube Data API v3 (optional): adds exact video duration. Resolution and
# playback work without it (oEmbed metadata + embed player).
YOUTUBE_API_KEY=
# vlrgg-scraper service (https://github.com/akhilnarang/vlrgg-scraper),
# e.g. http://localhost:8100 — enables VLR match auto-fill.
VLR_BASE_URL=
